# Local single-user application. No LLM request is sent until explicitly selected and confirmed.
MINEMOD_PORT=4310
MINEMOD_DATA_DIR=./.minemod

# Optional OpenAI-compatible Chat Completions endpoint. Restart after changing.
# Keep the API key server-side; never commit your .env.
# Cloud endpoints require HTTPS and an API key.
# MINEMOD_LLM_BASE_URL=https://your-provider.example/v1
# MINEMOD_LLM_MODEL=your-model-name
# MINEMOD_LLM_API_KEY=

# Local alternative: HTTP is allowed only on localhost / 127.0.0.1 / ::1.
# MINEMOD_LLM_BASE_URL=http://127.0.0.1:11434/v1
# MINEMOD_LLM_MODEL=your-installed-model
# MINEMOD_LLM_TIMEOUT_MS=45000
# MINEMOD_LLM_MAX_TOKENS=4096
# Set false if your provider does not accept response_format=json_object.
# MINEMOD_LLM_JSON_MODE=true
# For providers requiring the newer completion token field:
# MINEMOD_LLM_TOKEN_FIELD=max_completion_tokens

# Optional, independent OpenAI-compatible Images API (no request until explicitly confirmed).
# MINEMOD_IMAGE_BASE_URL=https://your-image-provider.example/v1
# MINEMOD_IMAGE_MODEL=your-image-model
# MINEMOD_IMAGE_API_KEY=your-image-key
# MINEMOD_IMAGE_TIMEOUT_MS=120000
# auto omits response_format, for providers that return b64_json without accepting that field.
# MINEMOD_IMAGE_RESPONSE_FORMAT=b64_json
