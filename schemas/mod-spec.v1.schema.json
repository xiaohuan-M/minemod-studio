{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MineMod ModSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "modId",
    "displayName",
    "target",
    "items",
    "recipes",
    "assumptions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "modId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,47}$"
    },
    "displayName": {
      "$ref": "#/$defs/name"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edition",
        "loader",
        "minecraft",
        "java"
      ],
      "properties": {
        "edition": {
          "const": "java"
        },
        "loader": {
          "const": "fabric"
        },
        "minecraft": {
          "const": "1.21.1"
        },
        "java": {
          "const": 21
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "displayName",
          "kind",
          "maxStackSize"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "displayName": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "zh_cn",
              "en_us"
            ],
            "properties": {
              "zh_cn": {
                "$ref": "#/$defs/name"
              },
              "en_us": {
                "$ref": "#/$defs/name"
              }
            }
          },
          "kind": {
            "const": "basic_item"
          },
          "maxStackSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          }
        }
      }
    },
    "recipes": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "pattern",
              "key",
              "result"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "type": {
                "const": "crafting_shaped"
              },
              "pattern": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 3,
                  "pattern": "^[ A-Z]+$"
                }
              },
              "key": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 9,
                "propertyNames": {
                  "pattern": "^[A-Z]$"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/resource"
                }
              },
              "result": {
                "$ref": "#/$defs/result"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "ingredients",
              "result"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "type": {
                "const": "crafting_shapeless"
              },
              "ingredients": {
                "type": "array",
                "minItems": 1,
                "maxItems": 9,
                "items": {
                  "$ref": "#/$defs/resource"
                }
              },
              "result": {
                "$ref": "#/$defs/result"
              }
            }
          }
        ]
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "resource": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,47}:[a-z][a-z0-9_]{0,63}$"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item",
        "count"
      ],
      "properties": {
        "item": {
          "$ref": "#/$defs/resource"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    }
  }
}
