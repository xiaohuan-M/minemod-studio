{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MineMod ModSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "modId",
    "displayName",
    "target",
    "items",
    "recipes",
    "assumptions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "modId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,47}$"
    },
    "displayName": {
      "$ref": "#/$defs/name"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edition",
        "loader",
        "minecraft",
        "java"
      ],
      "properties": {
        "edition": {
          "enum": [
            "java",
            "bedrock"
          ]
        },
        "loader": {
          "enum": [
            "fabric",
            "bedrock",
            "forge",
            "neoforge"
          ]
        },
        "minecraft": {
          "enum": [
            "1.20.1",
            "1.21.1",
            "1.21.60"
          ]
        },
        "java": {
          "enum": [
            17,
            21,
            0
          ]
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "displayName",
          "kind",
          "maxStackSize"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "displayName": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "zh_cn",
              "en_us"
            ],
            "properties": {
              "zh_cn": {
                "$ref": "#/$defs/name"
              },
              "en_us": {
                "$ref": "#/$defs/name"
              }
            }
          },
          "kind": {
            "enum": [
              "basic_item",
              "food",
              "sword",
              "pickaxe",
              "axe",
              "shovel",
              "hoe",
              "lightning_wand"
            ]
          },
          "maxStackSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "textureColor": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "textureAsset": {
            "$ref": "#/$defs/uuid"
          },
          "modelAsset": {
            "$ref": "#/$defs/uuid"
          },
          "food": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "nutrition": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "saturation": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              }
            },
            "required": [
              "nutrition",
              "saturation"
            ]
          },
          "tool": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "material": {
                "enum": [
                  "wood",
                  "stone",
                  "iron",
                  "gold",
                  "diamond",
                  "netherite"
                ]
              },
              "attackDamage": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20
              },
              "attackSpeed": {
                "type": "number",
                "minimum": -4,
                "maximum": 4
              }
            },
            "required": [
              "material",
              "attackDamage",
              "attackSpeed"
            ]
          },
          "cooldownSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          },
          "texturePrompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "自动创作需要绘制或修改此对象贴图时填写；只修改受影响对象，保留现有素材ID作为编辑基底。"
          },
          "modelPrompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "自动创作需要修改此对象几何或骨骼动作时填写；保留现有模型ID作为编辑基底，其他对象要求保持不变。"
          }
        }
      }
    },
    "recipes": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "pattern",
              "key",
              "result"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "type": {
                "const": "crafting_shaped"
              },
              "pattern": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 3,
                  "pattern": "^[ A-Z]+$"
                }
              },
              "key": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 9,
                "propertyNames": {
                  "pattern": "^[A-Z]$"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/resource"
                }
              },
              "result": {
                "$ref": "#/$defs/result"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "ingredients",
              "result"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "type": {
                "const": "crafting_shapeless"
              },
              "ingredients": {
                "type": "array",
                "minItems": 1,
                "maxItems": 9,
                "items": {
                  "$ref": "#/$defs/resource"
                }
              },
              "result": {
                "$ref": "#/$defs/result"
              }
            }
          }
        ]
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "blocks": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "displayName": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "zh_cn",
              "en_us"
            ],
            "properties": {
              "zh_cn": {
                "$ref": "#/$defs/name"
              },
              "en_us": {
                "$ref": "#/$defs/name"
              }
            }
          },
          "hardness": {
            "type": "number",
            "minimum": 0,
            "maximum": 50
          },
          "resistance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1200
          },
          "luminance": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "textureColor": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "textureAsset": {
            "$ref": "#/$defs/uuid"
          },
          "loot": {
            "$ref": "#/$defs/loot"
          },
          "modelAsset": {
            "$ref": "#/$defs/uuid"
          },
          "texturePrompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "自动创作需要绘制或修改此对象贴图时填写；只修改受影响对象，保留现有素材ID作为编辑基底。"
          },
          "modelPrompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "自动创作需要修改此对象几何或骨骼动作时填写；保留现有模型ID作为编辑基底，其他对象要求保持不变。"
          }
        },
        "required": [
          "id",
          "displayName",
          "hardness",
          "resistance",
          "luminance"
        ]
      }
    },
    "entities": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "displayName",
          "archetype",
          "health",
          "movementSpeed",
          "attackDamage"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "displayName": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "zh_cn",
              "en_us"
            ],
            "properties": {
              "zh_cn": {
                "$ref": "#/$defs/name"
              },
              "en_us": {
                "$ref": "#/$defs/name"
              }
            }
          },
          "archetype": {
            "enum": [
              "zombie",
              "cow"
            ]
          },
          "health": {
            "type": "number",
            "minimum": 1,
            "maximum": 200
          },
          "movementSpeed": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 1
          },
          "attackDamage": {
            "type": "number",
            "minimum": 0,
            "maximum": 30
          },
          "textureColor": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "textureAsset": {
            "$ref": "#/$defs/uuid"
          },
          "modelAsset": {
            "$ref": "#/$defs/uuid"
          },
          "animationClip": {
            "$ref": "#/$defs/id"
          },
          "loot": {
            "$ref": "#/$defs/loot"
          },
          "texturePrompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "自动创作需要绘制或修改此对象贴图时填写；只修改受影响对象，保留现有素材ID作为编辑基底。"
          },
          "modelPrompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "自动创作需要修改此对象几何或骨骼动作时填写；保留现有模型ID作为编辑基底，其他对象要求保持不变。"
          }
        }
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "resource": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,47}:[a-z][a-z0-9_]{0,63}$"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item",
        "count"
      ],
      "properties": {
        "item": {
          "$ref": "#/$defs/resource"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "loot": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item",
          "min",
          "max",
          "chance"
        ],
        "properties": {
          "item": {
            "$ref": "#/$defs/resource"
          },
          "min": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "max": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "chance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "playerOnly": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
